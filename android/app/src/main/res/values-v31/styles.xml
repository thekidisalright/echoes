<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: splash do sistema com o ícone do app sobre o fundo escuro.
         Repetido em values-night-v31: o qualificador night vence o v31. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/echoes_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/echoes_background</item>
    </style>
</resources>
